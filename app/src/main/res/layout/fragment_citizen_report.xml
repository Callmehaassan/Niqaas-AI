<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background"
    tools:context=".ui.citizen.CitizenReportFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Active Emergency Warning Banner (Urdu Advisory + Speak Option) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_emergency_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/severity_high_bg"
            app:strokeColor="@color/severity_high"
            app:strokeWidth="1.5dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_warning_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HIGH RISK FLOOD WARNING"
                        android:textColor="@color/severity_high"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/txt_warning_urdu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="علاقے میں پانی بڑھ رہا ہے - برائے مہربانی سامان محفوظ جگہ منتقل کریں۔"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_speak_warning"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:tint="@color/severity_high" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Header Card (Cockpit Style with Left Teal Accent Bar) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/gray_border"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/card_emergency_warning">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Left Accent Strip -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nikaas Citizen Portal"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Report localized street flooding directly. Your report fuses with traffic and weather signals to coordinate response teams."
                        android:textColor="@color/gray_text"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Location input field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_location_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="Enter Location (e.g., G-10 Sector)"
            app:boxStrokeColor="@color/primary"
            app:boxStrokeWidthFocused="2dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:hintTextColor="@color/primary"
            app:layout_constraintTop_toBottomOf="@id/card_header">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textColorHint="@color/gray_text"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_current_location"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Use Current Location"
            android:textColor="@color/primary"
            android:textSize="11sp"
            app:icon="@android:drawable/ic_menu_mylocation"
            app:iconTint="@color/primary"
            app:layout_constraintTop_toBottomOf="@id/input_location_layout"
            app:layout_constraintRight_toRightOf="parent" />

        <!-- Description field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_description_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Describe flooding (e.g. pani bhar gaya hai, sadak band hai)"
            app:boxStrokeColor="@color/primary"
            app:boxStrokeWidthFocused="2dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:hintTextColor="@color/primary"
            app:layout_constraintTop_toBottomOf="@id/btn_current_location">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textColorHint="@color/gray_text"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:lines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Optional Add Photo button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_photo"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="Add Photo (Optional)"
            android:textColor="@color/primary"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconTint="@color/primary"
            app:layout_constraintTop_toBottomOf="@id/input_description_layout" />

        <!-- Captured Photo Thumbnail Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_thumbnail"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/gray_border"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/btn_add_photo"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

            <ImageView
                android:id="@+id/img_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <!-- One-Tap Chips -->
        <LinearLayout
            android:id="@+id/phrases_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/card_thumbnail">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_phrase1"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="pani bhar gaya hai"
                android:textColor="@color/white"
                app:chipBackgroundColor="@color/surface"
                app:chipStrokeColor="@color/gray_border"
                app:chipStrokeWidth="1dp"
                android:textAlignment="center"
                android:textSize="10sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_phrase2"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="gaari phans gayi hai"
                android:textColor="@color/white"
                app:chipBackgroundColor="@color/surface"
                app:chipStrokeColor="@color/gray_border"
                app:chipStrokeWidth="1dp"
                android:textAlignment="center"
                android:textSize="10sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_phrase3"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="road band hai"
                android:textColor="@color/white"
                app:chipBackgroundColor="@color/surface"
                app:chipStrokeColor="@color/gray_border"
                app:chipStrokeWidth="1dp"
                android:textAlignment="center"
                android:textSize="10sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Submit Flood Report"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="10dp"
            app:layout_constraintTop_toBottomOf="@id/phrases_layout" />

        <!-- Submission Confirmation Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_confirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="@color/severity_low_bg"
            app:strokeColor="@color/severity_low"
            app:strokeWidth="1dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btn_submit">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ProgressBar
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:indeterminateTint="@color/severity_low" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Report submitted, analyzing..."
                    android:textColor="@color/severity_low"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- List Section -->
        <TextView
            android:id="@+id/lbl_recent_reports"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Recent Flood Activity Reports"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/card_confirmation"
            app:layout_constraintLeft_toLeftOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recent_reports"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/lbl_recent_reports" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
